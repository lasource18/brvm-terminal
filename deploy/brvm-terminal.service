[Unit]
Description=brvm-terminal (FastAPI + APScheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brvm
Group=brvm
WorkingDirectory=/opt/brvm-terminal
EnvironmentFile=/opt/brvm-terminal/.env
ExecStart=/opt/brvm-terminal/.venv/bin/uvicorn brvm.apps.web.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
MemoryMax=384M

[Install]
WantedBy=multi-user.target
