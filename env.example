# Copy this file to .env (which is git-ignored) and fill in as needed.
#
# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
DB_PATH=./data/brvm.sqlite
USER_TZ=America/Montreal

# --- optional commercial data provider ---
# NOTE: the previously-referenced "BRVM Market Data API" (Apify-hosted) was
# withdrawn in June 2026. These vars are kept so a future paid feed (EODHD,
# ICE, or a revived endpoint) can be plugged in via services/providers.py
# without touching downstream code. Leave blank to fall back to scrapers.
BRVM_API_BASE=
BRVM_API_KEY=

# --- LLM (Phase 3b news tagging) ---
# Leave blank to disable tagging entirely: ingest still runs, the tagger
# no-ops with a warning, and the UI just shows untagged news.
ANTHROPIC_API_KEY=
# Charter pins Haiku for high-volume tagging.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Hard daily ceiling in USD cents. 100 = $1/day; the worker stops once the
# day's accumulated spend (table `llm_spend`) crosses it.
LLM_DAILY_CAP_CENTS=100
# News items per request. Bigger amortizes the system prompt further.
LLM_BATCH_SIZE=8
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_CONSECUTIVE_FAILURES=3

# --- Filings extractor (Phase 4a lands the corpus; 4b turns these on) ---
# Separate cap from LLM_DAILY_CAP_CENTS above — an annual report is
# ~30-50k input tokens per call, so extraction gets its own budget line.
LLM_EXTRACT_DAILY_CAP_CENTS=200
EXTRACT_MAX_PDF_MB=25
FILINGS_ROOT=./data/filings

# --- OCR (Phase 4c) — rescues scanned French annual reports so they can be
# extracted. Requires the `ocrmypdf` binary and tesseract with the French
# language pack. On macOS: `brew install ocrmypdf tesseract-lang`.
OCR_BINARY=ocrmypdf
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT_S=600
OCR_MAX_PAGES=400
OCR_MAX_FILES_PER_RUN=20

# --- Alerts (Phase 6a) ---
# Optional. Leave blank to disable notifications entirely: rules still fire,
# alert_events still land in the DB, but the delivery worker marks each row
# 'skipped' instead of pushing it out. Any legitimate Discord webhook URL
# works — nothing else is currently supported.
DISCORD_WEBHOOK_URL=
# A rule that keeps re-matching (e.g. a ticker holds a +6% day for hours)
# only fires once per this window. Same (rule_id, dedupe_key) inside the
# window is dropped at the store layer.
ALERTS_DEDUPE_WINDOW_HOURS=24
# Cap events queued for one delivery pass so a webhook outage doesn't
# produce a 50-message avalanche when it recovers.
ALERTS_DELIVERY_BATCH=10

# --- Daily brief (Phase 6b) ---
# Starts on Haiku to keep the cost line predictable (same $/tok as the
# 3b tagger). Flip to claude-sonnet-4-6 later if the write-up quality
# warrants the price step.
BRIEF_MODEL=claude-haiku-4-5-20251001
# $0.50/day cap. One brief per weekday; Haiku at ~2k output tokens
# rounds to fractions of a cent, so the cap is mostly a safety net.
BRIEF_DAILY_CAP_CENTS=50
# Relevance floor for news items handed to the brief writer. Anything
# below this is dropped from the prompt.
BRIEF_MIN_RELEVANCE=6
# Hard cap on news items in the prompt. Truncates to most-relevant
# first on a very newsy day.
BRIEF_MAX_NEWS_ITEMS=30
# Output tokens ceiling — comfortable for a ~500-word markdown brief.
BRIEF_MAX_OUTPUT_TOKENS=2048

# --- scraper etiquette ---
HTTP_USER_AGENT=brvm-terminal/0.1 (+contact: cmguinan@yahoo.fr)
HTTP_TIMEOUT_S=15
