# Copy this file to .env (which is git-ignored) and fill in as needed.
#
# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
DB_PATH=./data/kodji.sqlite

# --- optional commercial data provider ---
# NOTE: the previously-referenced "BRVM Market Data API" (Apify-hosted) was
# withdrawn in June 2026. These vars are kept so a future paid feed (EODHD,
# ICE, or a revived endpoint) can be plugged in via services/providers.py
# without touching downstream code. Leave blank to fall back to scrapers.
BRVM_API_BASE=
BRVM_API_KEY=

# --- LLM (Phase 3b news tagging) ---
# Leave blank to disable tagging entirely: ingest still runs, the tagger
# no-ops with a warning, and the UI just shows untagged news.
ANTHROPIC_API_KEY=
# Charter pins Haiku for high-volume tagging.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Hard daily ceiling in USD cents. 100 = $1/day; the worker stops once the
# day's accumulated spend (table `llm_spend`) crosses it.
LLM_DAILY_CAP_CENTS=100
# News items per request. Bigger amortizes the system prompt further.
LLM_BATCH_SIZE=8
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_CONSECUTIVE_FAILURES=3

# --- Filings extractor (Phase 4a lands the corpus; 4b turns these on) ---
# Separate cap from LLM_DAILY_CAP_CENTS above — an annual report is
# ~30-50k input tokens per call, so extraction gets its own budget line.
LLM_EXTRACT_DAILY_CAP_CENTS=200
EXTRACT_MAX_PDF_MB=25
FILINGS_ROOT=./data/filings

# --- OCR (Phase 4c) — rescues scanned French annual reports so they can be
# extracted. Requires the `ocrmypdf` binary and tesseract with the French
# language pack. On macOS: `brew install ocrmypdf tesseract-lang`.
OCR_BINARY=ocrmypdf
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT_S=600
OCR_MAX_PAGES=400
OCR_MAX_FILES_PER_RUN=20

# --- Alerts (Phase 6a) ---
# Optional. Leave blank to disable notifications entirely: rules still fire,
# alert_events still land in the DB, but the delivery worker marks each row
# 'skipped' instead of pushing it out. Any legitimate Discord webhook URL
# works — nothing else is currently supported.
DISCORD_WEBHOOK_URL=
# A rule that keeps re-matching (e.g. a ticker holds a +6% day for hours)
# only fires once per this window. Same (rule_id, dedupe_key) inside the
# window is dropped at the store layer.
ALERTS_DEDUPE_WINDOW_HOURS=24
# Cap events queued for one delivery pass so a webhook outage doesn't
# produce a 50-message avalanche when it recovers.
ALERTS_DELIVERY_BATCH=10

# --- Authentication + outbound email (PR-X2) ---
# Magic-link sign-in. Resend is the provider (chosen 31 Aug 2026): its free
# tier covers the whole pre-revenue period and it sends from Ireland, the
# closest region to West Africa by network path. Deliverability to Abidjan
# or Dakar is decided by the recipient's mailbox provider (Gmail/Yahoo/
# Outlook) and by SPF+DKIM+DMARC on the sending domain, not by the vendor.
# Leave RESEND_API_KEY blank in dev: the mailer logs the message (link and
# code included) instead of sending it, so sign-in still works locally.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Use a dedicated subdomain for
# sign-in mail so a future daily-brief blast can't spend its reputation:
#   EMAIL_FROM=Kodji <connexion@mail.kodji.ci>
EMAIL_FROM=
# Absolute origin used to build the emailed link. SET THIS IN PRODUCTION:
# behind Cloudflare + Caddy the request's own host is whatever the last
# proxy claimed, and a link built from a spoofed Host header would send a
# live credential to someone else's domain. Blank = derive from the
# request, which is correct for local dev only.
PUBLIC_BASE_URL=
# Link/code lifetime in minutes. Generous on purpose — on a mobile
# connection that drops, a 5-minute link expires between send and open.
LOGIN_TOKEN_TTL_MINUTES=20
# Wrong 6-digit guesses before the challenge is burned.
LOGIN_CODE_MAX_ATTEMPTS=5
# Sign-in requests accepted per address per hour.
LOGIN_MAX_PER_HOUR=5
SESSION_TTL_DAYS=30
# Off until PR-Y lands route-level gating. While it is off, a request with
# no session resolves to the default account — fine for the single-user
# box, NOT fine once the app is reachable by anyone else. Set to true
# before exposing it publicly.
AUTH_REQUIRED=false

# --- Daily brief (Phase 6b) ---
# Starts on Haiku to keep the cost line predictable (same $/tok as the
# 3b tagger). Flip to claude-sonnet-4-6 later if the write-up quality
# warrants the price step.
BRIEF_MODEL=claude-haiku-4-5-20251001
# $0.50/day cap. One brief per weekday; Haiku at ~2k output tokens
# rounds to fractions of a cent, so the cap is mostly a safety net.
BRIEF_DAILY_CAP_CENTS=50
# Relevance floor for news items handed to the brief writer. Anything
# below this is dropped from the prompt.
BRIEF_MIN_RELEVANCE=6
# Hard cap on news items in the prompt. Truncates to most-relevant
# first on a very newsy day.
BRIEF_MAX_NEWS_ITEMS=30
# Output tokens ceiling — comfortable for a ~500-word markdown brief.
BRIEF_MAX_OUTPUT_TOKENS=2048

# --- Analyst notes (Phase 6c) ---
# Weekly per-ticker synthesis rendered on `/s/{ticker}/analyst`. Sonnet
# by user choice — an analyst note is much richer than a daily brief
# and benefits from the deeper reasoning. A full 47-ticker weekly pass
# at Sonnet rates is ~$1.90.
NOTES_MODEL=claude-sonnet-4-6
# $3/day cap: covers a full weekly pass + one full retry of headroom.
NOTES_DAILY_CAP_CENTS=300
# News lookback per ticker for the prompt context (30 days covers a
# full month of communiqués + typical earnings cycle).
NOTES_LOOKBACK_DAYS=30
# Ceiling on news items fed to the model per ticker.
NOTES_MAX_NEWS_ITEMS=25
# Output tokens — Sonnet writes longer than Haiku; 3k is comfortable
# for a 1000-1200 word note with several sections.
NOTES_MAX_OUTPUT_TOKENS=3072
# Polite pause between per-ticker calls so a 47-ticker weekly pass
# doesn't hammer the API in a burst.
NOTES_DELAY_BETWEEN_S=0.5

# --- scraper etiquette ---
HTTP_USER_AGENT=kodji-terminal/0.1 (+contact: cmguinan@yahoo.fr)
HTTP_TIMEOUT_S=15
